        ]
      },
      "walking": {
        "description": "Four-beat gait with alternating legs",
        "sequence": "Hind leg, diagonal front leg, other hind leg, other front leg",
        "key_points": [
          "Always has at least two feet on ground",
          "Head nods slightly with rhythm",
          "Minimal vertical movement"
        ],
        "common_mistakes": [
          "Incorrect leg sequence",
          "Unrealistic leg extension",
          "Missing subtle weight shifts"
        ],
        "diagram_reference": "walking_sequence.png"
      },
      "trotting": {
        "description": "Two-beat diagonal gait",
        "sequence": "Diagonal pairs of legs move together (right front/left hind, then left front/right hind)",
        "key_points": [
          "Brief suspension phase between diagonal pairs",
          "More pronounced head and neck motion than walk",
          "Tail may lift slightly"
        ],
        "variations": [
          {
            "name": "Working trot",
            "characteristics": "Moderate speed, balanced, functional",
            "diagram_reference": "working_trot.png"
