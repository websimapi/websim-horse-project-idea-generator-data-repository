      "walk": {
        "description": "Four-beat gait with sequence: RH, RF, LH, LF",
        "timing": "Even spacing between footfalls",
        "key_observations": [
          "Minimal vertical movement of body",
          "Head nods slightly downward as each front foot lifts",
          "Lateral legs never leave ground simultaneously"
        ],
        "reference_animation": "walk_mechanics.mp4"
      },
      "trot": {
        "description": "Two-beat diagonal gait: RF+LH, LF+RH",
        "timing": "Even timing with suspension between diagonal pairs",
        "key_observations": [
          "Pronounced vertical body movement",
          "Head reaches lowest point during diagonal support",
          "Suspension phase varies with speed (minimal in working trot, pronounced in extended)"
        ],
        "reference_animation": "trot_mechanics.mp4"
      },
      "canter": {
        "description": "Three-beat gait with sequence: (1) outside hind, (2) diagonal pair, (3) inside front, followed by suspension",
        "leads": {
          "description": "Lead determined by last leg to leave ground",
          "right_lead": "Sequence: LH, RH+LF, RF, suspension",
          "left_lead": "Sequence: RH, LH+RF, LF, suspension"
        },
        "key_observations": [
          "Rocking chair motion of body",
          "Inside hind leg experiences greatest stress",
          "Collection/extension changes frame dramatically"
        ],
        "reference_animation": "canter_mechanics.mp4"
      },
      "gallop": {
        "description": "Fast, four-beat gait with extended suspension",
        "sequence": "Extended to (1) outside hind, (2) inside hind, (3) outside front, (4) inside front, followed by suspension",
        "key_observations": [
          "Maximum extension during suspension phase",
          "Gathering phase where legs collect under body",
          "Body rocks forward substantially during stride"
        ],
        "variations": {
          "transverse_gallop": "Most common in horses, diagonal legs work together",
          "rotary_gallop": "Rare in horses, more common in cheetahs and greyhounds"
        },
        "reference_animation": "gallop_mechanics.mp4"
      }
    }
  },
