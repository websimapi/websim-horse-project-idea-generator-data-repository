            "name": "Extended trot",
            "characteristics": "Greater reach, more suspension, dramatic action",
            "diagram_reference": "extended_trot.png"
          }
        ],
        "diagram_reference": "trot_sequence.png"
      },
      "cantering": {
        "description": "Three-beat gait with suspension",
        "sequence": "Outside hind leg, diagonal pair (inside hind and outside front), inside front leg, moment of suspension",
        "key_points": [
          "Lead determined by last leg to leave ground before suspension",
          "Rocking motion more pronounced than trot",
          "Collection/extension affects frame dramatically"
        ],
        "common_mistakes": [
          "Incorrect footfall sequence",
          "Unrealistic body position during suspension",
          "Missing the 'lead' concept"
        ],
        "diagram_reference": "canter_sequence.png"
      },
      "galloping": {
        "description": "Fast four-beat gait with extended suspension",
